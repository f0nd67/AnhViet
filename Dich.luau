local function dichCau(text)
    if not text or #text < 1 then return text end
    local goc = text
    local kq = text
    for cum, thay in pairs(TU_DIEN) do
        if cum:find(" ", 1, true) then
            kq = kq:gsub("%f[%a]" .. cum .. "%f[%A]", thay)
        end
    end
    local ketQua = {}
    local i, n = 1, #kq
    while i <= n do
        local c = kq:sub(i, i)
        if c:match("[%a]") then
            local j = i
            while j <= n and kq:sub(j, j):match("[%a']") do j = j + 1 end
            local word = kq:sub(i, j - 1)
            local lower = word:lower()
            local dich = TU_DIEN[lower]
            if not dich then local t2 = lower:gsub("s$", "") if TU_DIEN[t2] then dich = TU_DIEN[t2] end end
            if not dich then local t3 = lower:gsub("ing$", "") if TU_DIEN[t3] then dich = TU_DIEN[t3] end end
            if not dich then local t4 = lower:gsub("ed$", "") if TU_DIEN[t4] then dich = TU_DIEN[t4] end end
            if not dich then local t5 = lower:gsub("er$", "") if TU_DIEN[t5] then dich = TU_DIEN[t5] end end
            if dich and #dich > 0 then
                if word:match("^%u") then dich = dich:sub(1,1):upper() .. dich:sub(2) end
                table.insert(ketQua, dich)
            elseif dich == "" then
                table.insert(ketQua, "")
            else
                table.insert(ketQua, word)
            end
            i = j
        else
            local j = i
            while j <= n and not kq:sub(j, j):match("[%a]") do j = j + 1 end
            table.insert(ketQua, kq:sub(i, j - 1))
            i = j
        end
    end
    local final = table.concat(ketQua):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if #final < 1 then return goc end
    return final
end

local cacheDich = {}
local function dich(text)
    if not text or type(text) ~= "string" then return text end
    if #text < 1 or not text:match("%a") then return text end
    if cacheDich[text] then return cacheDich[text] end
    local kq = dichCau(text)
    cacheDich[text] = kq
    return kq
end

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local Player  = Players.LocalPlayer
local daXuLy  = {}

local function xuLy(obj)
    if not obj or daXuLy[obj] then return end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        daXuLy[obj] = true
        local goc = obj.Text
        local moi = dich(goc)
        if moi ~= goc then pcall(function() obj.Text = moi end) end
        if obj:IsA("TextBox") then
            local g2 = obj.PlaceholderText
            local m2 = dich(g2)
            if m2 ~= g2 then pcall(function() obj.PlaceholderText = m2 end) end
            obj:GetPropertyChangedSignal("PlaceholderText"):Connect(function()
                local m = dich(obj.PlaceholderText)
                if m ~= obj.PlaceholderText then pcall(function() obj.PlaceholderText = m end) end
            end)
        end
        obj:GetPropertyChangedSignal("Text"):Connect(function()
            local m = dich(obj.Text)
            if m ~= obj.Text then pcall(function() obj.Text = m end) end
        end)
    end
end

local function quet(root)
    if not root then return end
    xuLy(root)
    for _, c in ipairs(root:GetDescendants()) do xuLy(c) end
    root.DescendantAdded:Connect(function(o)
        task.wait(0.05)
        xuLy(o)
        for _, c in ipairs(o:GetDescendants()) do xuLy(c) end
    end)
end

pcall(quet, CoreGui)
pcall(quet, Player:FindFirstChildOfClass("PlayerGui"))
pcall(quet, Player:FindFirstChild("PlayerScripts"))

task.spawn(function()
    while true do
        task.wait(1.5)
        pcall(function()
            for _, g in ipairs(CoreGui:GetChildren()) do
                if not daXuLy[g] then quet(g) end
            end
            local pg = Player:FindFirstChildOfClass("PlayerGui")
            if pg then
                for _, g in ipairs(pg:GetChildren()) do
                    if not daXuLy[g] then quet(g) end
                end
            end
        end)
    end
end)
